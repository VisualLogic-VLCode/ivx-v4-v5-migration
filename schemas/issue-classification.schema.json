{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "iVX migration issue classification",
  "type": "object",
  "required": ["schemaVersion", "issues"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issueId", "owner", "confidence", "reason", "repairAllowed"],
        "properties": {
          "issueId": { "type": "string" },
          "owner": { "enum": ["CONVERTER", "SOURCE", "PLATFORM", "AUTHORIZATION", "UNKNOWN"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "repairAllowed": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
