{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "iVX migration platform Save As journal",
  "type": "object",
  "required": ["schemaVersion", "jobId", "phase", "source", "target", "config", "finalSave", "verification", "attempts"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "jobId": { "type": "string", "pattern": "^mig_[A-Za-z0-9_]+$" },
    "phase": { "type": "string" },
    "intent": {
      "type": "object",
      "required": ["kind", "authorizationArtifact"],
      "properties": {
        "kind": { "enum": ["validated", "known-issues-diagnostic"] },
        "authorizationArtifact": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "source": { "type": "object" },
    "target": { "type": "object" },
    "config": {
      "type": "object",
      "properties": {
        "expectedSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "appliedAt": { "type": "string" }
      },
      "additionalProperties": true
    },
    "domainRouting": {
      "type": "object",
      "required": ["policy", "required", "status"],
      "properties": {
        "policy": { "const": "COPY_SOURCE_DOMAINS_PRESERVE_TARGET_PATHS" },
        "required": { "type": "boolean" },
        "status": {
          "enum": ["PENDING", "REQUESTED", "OUTCOME_UNKNOWN", "INCOMPLETE", "CONFIRMED", "LEGACY_SKIPPED"]
        },
        "source": {
          "type": "object",
          "required": ["domain", "previewDomain", "customDomain"],
          "properties": {
            "domain": { "type": "string" },
            "previewDomain": { "type": "string" },
            "customDomain": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "targetPathSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "expected": {
          "type": "object",
          "required": ["domain", "path", "previewDomain", "previewPath", "customDomain", "pubRoot", "preRoot"],
          "properties": {
            "domain": { "type": "string" },
            "path": { "type": "string" },
            "previewDomain": { "type": "string" },
            "previewPath": { "type": "string" },
            "customDomain": { "type": "boolean" },
            "pubRoot": { "type": "boolean" },
            "preRoot": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "expectedSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "preparedAt": { "type": "string" },
        "requestedAt": { "type": "string" },
        "appliedAt": { "type": "string" },
        "skippedAt": { "type": "string" },
        "skipReason": { "type": "string" },
        "confirmation": { "type": "string" },
        "error": { "type": "object" }
      },
      "additionalProperties": false
    },
    "finalSave": { "type": "object" },
    "verification": { "type": "object" },
    "attempts": { "type": "array" }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": 2 } } },
      "then": { "required": ["intent"] }
    }
  ]
}
