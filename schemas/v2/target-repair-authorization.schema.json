{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ivx.local/migration/v2/target-repair-authorization.schema.json",
  "title": "iVX Target Repair Authorization v2",
  "type": "object",
  "required": ["schemaVersion", "kind", "authorizationId", "reviewId", "scope", "clusterIds", "maxAttemptsPerCluster", "maxTargetRevisions", "confirmation", "expiresAt", "createdAt", "createdBy", "sensitivity"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "target-repair-authorization" },
    "authorizationId": { "$ref": "common.schema.json#/$defs/id" },
    "reviewId": { "$ref": "common.schema.json#/$defs/reviewId" },
    "scope": { "enum": ["INITIAL", "EXTENSION"] },
    "clusterIds": { "$ref": "common.schema.json#/$defs/stringArray", "minItems": 1, "maxItems": 200 },
    "maxAttemptsPerCluster": { "type": "integer", "minimum": 1, "maximum": 3 },
    "maxTargetRevisions": { "type": "integer", "minimum": 1, "maximum": 10 },
    "confirmation": { "enum": ["AUTHORIZE_TARGET_REPAIR", "AUTHORIZE_REPAIR_EXTENSION"] },
    "expiresAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "createdAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "createdBy": { "const": "USER" },
    "sensitivity": { "const": "PRIVATE" }
  },
  "additionalProperties": false
}
