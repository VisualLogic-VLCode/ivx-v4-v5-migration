{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ivx.local/migration/v2/agent-native-observation-bundle.schema.json",
  "title": "Agent Native Observation Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "runId", "previousRunId", "repairBatchId", "reviewId", "jobId", "purpose", "subjects", "environment", "execution", "outcome", "coverage", "exploration", "effects", "findings", "evidenceRefs", "claims", "completedAt", "createdAt", "createdBy", "sensitivity"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "agent-native-observation-bundle" },
    "runId": { "$ref": "#/$defs/id" },
    "previousRunId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "repairBatchId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "reviewId": { "type": "string", "pattern": "^rev_[A-Za-z0-9_]+$" },
    "jobId": { "type": "string", "pattern": "^mig_[A-Za-z0-9_]+$" },
    "purpose": { "enum": ["INITIAL_TEST", "USER_RETEST", "REPAIR_REGRESSION"] },
    "subjects": {
      "type": "object", "additionalProperties": false, "required": ["source", "target"],
      "properties": { "source": { "$ref": "#/$defs/subject" }, "target": { "$ref": "#/$defs/subject" } }
    },
    "environment": {
      "type": "object", "additionalProperties": false, "required": ["comparisonId", "status", "differences"],
      "properties": {
        "comparisonId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "status": { "enum": ["ENVIRONMENT_EQUIVALENT", "NORMALIZED_EQUIVALENT", "REQUIRES_USER_BINDING", "BLOCKED_ENVIRONMENT", null] },
        "differences": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/difference" } }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false, "required": ["tools", "startedAt", "completedAt"],
      "properties": {
        "tools": { "$ref": "#/$defs/stringArray" },
        "startedAt": { "$ref": "#/$defs/dateTime" },
        "completedAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "outcome": { "enum": ["OBSERVED_EQUIVALENT", "OBSERVED_MISMATCH", "INCONCLUSIVE"] },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["businessFlows", "states", "actions", "assertions", "screenshots", "networkObservations"],
      "properties": {
        "businessFlows": { "$ref": "#/$defs/count" }, "states": { "$ref": "#/$defs/count" },
        "actions": { "$ref": "#/$defs/count" }, "assertions": { "$ref": "#/$defs/count" },
        "screenshots": { "$ref": "#/$defs/count" }, "networkObservations": { "$ref": "#/$defs/count" }
      }
    },
    "exploration": { "$ref": "#/$defs/exploration" },
    "effects": {
      "type": "object", "additionalProperties": false, "required": ["occurred", "systems", "summaries"],
      "properties": { "occurred": { "type": "boolean" }, "systems": { "$ref": "#/$defs/stringArray" }, "summaries": { "$ref": "#/$defs/stringArray" } }
    },
    "findings": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/finding" } },
    "evidenceRefs": { "$ref": "#/$defs/pathArray" },
    "claims": {
      "type": "object", "additionalProperties": false, "required": ["strictParityClaimed", "workflowRestrictionsApplied", "wholeCaseObservedEquivalentClaimed"],
      "properties": {
        "strictParityClaimed": { "const": false },
        "workflowRestrictionsApplied": { "const": false },
        "wholeCaseObservedEquivalentClaimed": { "type": "boolean" }
      }
    },
    "completedAt": { "$ref": "#/$defs/dateTime" },
    "createdAt": { "$ref": "#/$defs/dateTime" },
    "createdBy": { "const": "AGENT" },
    "sensitivity": { "const": "REDACTED" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "dateTime": { "type": "string", "format": "date-time" },
    "count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "nullableString": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 4096 }, { "type": "null" }] },
    "exploration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "inventory", "sideEffectPolicy", "surfaceInventory", "candidateFlows", "coverageAssessment", "queue"],
      "properties": {
        "scope": { "enum": ["WHOLE_CASE", "AFFECTED_FLOWS"] },
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["smokeTestCompleted", "staticArtifactsInspected", "runtimeSurfaceInspected", "navigationInspected", "serviceCallsInspected"],
          "properties": {
            "smokeTestCompleted": { "type": "boolean" },
            "staticArtifactsInspected": { "type": "boolean" },
            "runtimeSurfaceInspected": { "type": "boolean" },
            "navigationInspected": { "type": "boolean" },
            "serviceCallsInspected": { "type": "boolean" }
          }
        },
        "sideEffectPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "scopeSummary"],
          "properties": {
            "mode": { "enum": ["NOT_AUTHORIZED", "USER_AUTHORIZED"] },
            "scopeSummary": { "$ref": "#/$defs/nullableString" }
          }
        },
        "surfaceInventory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["units", "summary"],
          "properties": {
            "units": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/surfaceUnit" } },
            "summary": {
              "type": "object",
              "additionalProperties": false,
              "required": ["unitCount", "mappedCount", "excludedCount", "deferredCount", "reconciled"],
              "properties": {
                "unitCount": { "$ref": "#/$defs/count" },
                "mappedCount": { "$ref": "#/$defs/count" },
                "excludedCount": { "$ref": "#/$defs/count" },
                "deferredCount": { "$ref": "#/$defs/count" },
                "reconciled": { "const": true }
              }
            }
          }
        },
        "candidateFlows": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/candidateFlow" } },
        "coverageAssessment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "inventoryComplete", "surfaceReconciled", "coveredUnitCount", "gapUnitCount", "criticalGapCount", "importantGapCount", "edgeGapCount", "residualGapUnitIds", "unresolvedInventory"],
          "properties": {
            "status": { "enum": ["COMPLETE", "PARTIAL", "BLOCKED"] },
            "inventoryComplete": { "type": "boolean" },
            "surfaceReconciled": { "const": true },
            "coveredUnitCount": { "$ref": "#/$defs/count" },
            "gapUnitCount": { "$ref": "#/$defs/count" },
            "criticalGapCount": { "$ref": "#/$defs/count" },
            "importantGapCount": { "$ref": "#/$defs/count" },
            "edgeGapCount": { "$ref": "#/$defs/count" },
            "residualGapUnitIds": { "$ref": "#/$defs/idArray" },
            "unresolvedInventory": {
              "type": "array",
              "maxItems": 5,
              "uniqueItems": true,
              "items": { "enum": ["smokeTestCompleted", "staticArtifactsInspected", "runtimeSurfaceInspected", "navigationInspected", "serviceCallsInspected"] }
            }
          }
        },
        "queue": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidateCount", "fullyExecutedCount", "preSubmitCount", "blockedCount", "notExecutedCount", "unknownEffectCount", "exhausted"],
          "properties": {
            "candidateCount": { "$ref": "#/$defs/count" },
            "fullyExecutedCount": { "$ref": "#/$defs/count" },
            "preSubmitCount": { "$ref": "#/$defs/count" },
            "blockedCount": { "$ref": "#/$defs/count" },
            "notExecutedCount": { "$ref": "#/$defs/count" },
            "unknownEffectCount": { "$ref": "#/$defs/count" },
            "exhausted": { "type": "boolean" }
          }
        }
      }
    },
    "surfaceUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitId", "kind", "summary", "criticality", "discoverySources", "disposition", "reason", "evidenceRefs"],
      "properties": {
        "unitId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["PAGE_VIEW", "NAVIGATION_TRANSITION", "INTERACTION", "EVENT_SERVICE", "ROLE_PERMISSION", "BUSINESS_STATE", "DATA_VARIANT", "EXCEPTION_BRANCH", "WRITE_POSTCONDITION"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "criticality": { "enum": ["CORE", "IMPORTANT", "EDGE"] },
        "discoverySources": { "$ref": "#/$defs/discoverySources" },
        "disposition": { "enum": ["MAPPED_TO_FLOW", "EXCLUDED", "DEFERRED"] },
        "reason": { "$ref": "#/$defs/nullableString" },
        "evidenceRefs": { "$ref": "#/$defs/pathArray" }
      }
    },
    "candidateFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flowId", "summary", "criticality", "coverageUnitIds", "discoverySources", "preconditionSummary", "expectedResultSummary", "effectClass", "executionScope", "verificationDepth", "effectObservation", "postconditionObserved", "result", "stepCount", "stopReason", "blocker", "evidenceRefs"],
      "properties": {
        "flowId": { "$ref": "#/$defs/id" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "criticality": { "enum": ["CORE", "IMPORTANT", "EDGE"] },
        "coverageUnitIds": { "$ref": "#/$defs/nonEmptyIdArray" },
        "discoverySources": { "$ref": "#/$defs/discoverySources" },
        "preconditionSummary": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "expectedResultSummary": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "effectClass": { "enum": ["READ_ONLY", "WRITE", "UNKNOWN"] },
        "executionScope": { "enum": ["FULLY_EXECUTED", "PRE_SUBMIT_BOUNDARY", "BLOCKED", "NOT_EXECUTED"] },
        "verificationDepth": { "enum": ["READ_ONLY_RESULT", "PRE_SUBMIT", "POST_WRITE_RESULT", "NONE"] },
        "effectObservation": { "enum": ["NONE", "OCCURRED", "ATTEMPTED_NO_EFFECT", "UNKNOWN"] },
        "postconditionObserved": { "type": "boolean" },
        "result": { "enum": ["MATCHED", "MISMATCH", "INCONCLUSIVE", "NOT_OBSERVED"] },
        "stepCount": { "$ref": "#/$defs/count" },
        "stopReason": { "$ref": "#/$defs/nullableString" },
        "blocker": { "anyOf": [{ "$ref": "#/$defs/blocker" }, { "type": "null" }] },
        "evidenceRefs": { "$ref": "#/$defs/pathArray" }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "unblockingDisposition", "attemptCount", "summary", "evidenceRefs"],
      "properties": {
        "kind": { "enum": ["AUTHORIZATION", "ROLE_PERMISSION", "BUSINESS_STATE", "DATA_CONDITION", "ENVIRONMENT", "TEST_HARNESS", "USER_POLICY", "UNKNOWN"] },
        "unblockingDisposition": { "enum": ["ATTEMPTED", "NOT_SAFE", "NOT_AVAILABLE", "NOT_AUTHORIZED"] },
        "attemptCount": { "$ref": "#/$defs/count" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "evidenceRefs": { "$ref": "#/$defs/pathArray" }
      }
    },
    "subject": {
      "type": "object", "additionalProperties": false, "required": ["nid", "workId", "url", "origin"],
      "properties": {
        "nid": { "type": "integer", "minimum": 1 }, "workId": { "$ref": "#/$defs/nullableString" },
        "url": { "$ref": "#/$defs/nullableString" }, "origin": { "$ref": "#/$defs/nullableString" }
      }
    },
    "difference": {
      "type": "object", "additionalProperties": false, "required": ["path", "summary"],
      "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 1024 }, "summary": { "type": "string", "minLength": 1, "maxLength": 2048 } }
    },
    "stringArray": { "type": "array", "maxItems": 200, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
    "idArray": { "type": "array", "maxItems": 5000, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "nonEmptyIdArray": { "type": "array", "minItems": 1, "maxItems": 5000, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "discoverySources": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["STATIC_ARTIFACT", "RUNTIME_UI", "RUNTIME_NETWORK", "USER_INPUT"] } },
    "pathArray": { "type": "array", "maxItems": 2000, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*\\.\\.).+$" } },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["findingId", "severity", "status", "summary", "candidateCause", "evidenceRefs"],
      "properties": {
        "findingId": { "$ref": "#/$defs/id" }, "severity": { "enum": ["INFO", "WARNING", "ERROR"] },
        "status": { "enum": ["MATCHED", "MISMATCH", "INCONCLUSIVE"] }, "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "candidateCause": { "enum": ["CONVERTER", "SOURCE_DATA", "TARGET_CASE", "TEST_HARNESS", "ENVIRONMENT_CONFIGURATION", "PLATFORM_RUNTIME", "KNOWLEDGE_GAP", "AUTHORIZATION", "FLAKY_RUNTIME", "UNKNOWN", null] },
        "evidenceRefs": { "$ref": "#/$defs/pathArray" }
      }
    }
  }
}
