{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ivx.local/migration/v2/environment-manifest.schema.json",
  "title": "iVX Environment Manifest v2",
  "type": "object",
  "required": ["schemaVersion", "kind", "manifestId", "reviewId", "subject", "revision", "fields", "redaction", "createdAt", "createdBy", "sensitivity"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "environment-manifest" },
    "manifestId": { "$ref": "common.schema.json#/$defs/id" },
    "reviewId": { "$ref": "common.schema.json#/$defs/reviewId" },
    "subject": { "enum": ["SOURCE_V4", "TARGET_V5"] },
    "revision": {
      "type": "object",
      "required": ["nid", "workId"],
      "properties": {
        "nid": { "type": "integer", "minimum": 1 },
        "workId": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "additionalProperties": false
    },
    "fields": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": ["path", "policy", "presence", "valueType", "comparisonDigest", "equivalent"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "policy": {
            "oneOf": [
              { "enum": ["COPY_EXACT", "REMAP_FOR_TARGET", "USE_TARGET_BINDING", "REQUIRE_USER_BINDING", "REDACT_AND_COMPARE", "IGNORE_FOR_PARITY"] },
              { "type": "null" }
            ]
          },
          "presence": { "enum": ["PRESENT", "ABSENT", "UNKNOWN"] },
          "valueType": { "type": ["string", "null"], "maxLength": 128 },
          "comparisonDigest": {
            "oneOf": [{ "$ref": "common.schema.json#/$defs/sha256" }, { "type": "null" }]
          },
          "equivalent": { "type": ["boolean", "null"] }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "presence": { "enum": ["ABSENT", "UNKNOWN"] } }, "required": ["presence"] },
            "then": { "properties": { "valueType": { "type": "null" }, "comparisonDigest": { "type": "null" } } }
          }
        ]
      }
    },
    "redaction": {
      "type": "object",
      "required": ["applied", "policyVersion"],
      "properties": {
        "applied": { "const": true },
        "policyVersion": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "createdAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "createdBy": { "$ref": "common.schema.json#/$defs/createdBy" },
    "sensitivity": { "$ref": "common.schema.json#/$defs/sensitivity" }
  },
  "additionalProperties": false
}
