{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ivx.local/migration/v2/runtime-scenario.schema.json",
  "title": "iVX Runtime Scenario v2",
  "type": "object",
  "required": ["schemaVersion", "kind", "scenarioId", "version", "name", "source", "sideEffect", "executionPolicy", "preconditions", "actions", "assertions", "cleanup", "knowledgeRuleIds", "createdAt", "createdBy", "sensitivity"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "runtime-scenario" },
    "scenarioId": { "$ref": "common.schema.json#/$defs/id" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "source": {
      "type": "object",
      "required": ["type", "reference"],
      "properties": {
        "type": { "enum": ["USER", "MAINTAINER", "DETERMINISTIC", "AI"] },
        "reference": { "type": ["string", "null"], "maxLength": 512 }
      },
      "additionalProperties": false
    },
    "sideEffect": { "enum": ["READ_ONLY", "REVERSIBLE", "EXTERNAL_SIDE_EFFECT"] },
    "executionPolicy": {
      "type": "object",
      "required": ["mode", "authorizationRequired", "cleanupRequired"],
      "properties": {
        "mode": { "enum": ["UNATTENDED", "USER_VISIBLE"] },
        "authorizationRequired": { "type": "boolean" },
        "cleanupRequired": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "preconditions": { "$ref": "common.schema.json#/$defs/stringArray" },
    "actions": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/step" }
    },
    "assertions": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/assertion" }
    },
    "cleanup": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/step" }
    },
    "knowledgeRuleIds": { "$ref": "common.schema.json#/$defs/stringArray" },
    "createdAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "createdBy": { "$ref": "common.schema.json#/$defs/createdBy" },
    "sensitivity": { "$ref": "common.schema.json#/$defs/sensitivity" }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["stepId", "type"],
      "properties": {
        "stepId": { "$ref": "common.schema.json#/$defs/id" },
        "type": { "$ref": "common.schema.json#/$defs/id" },
        "target": { "type": "string", "minLength": 1, "maxLength": 512 },
        "input": { "type": ["string", "number", "boolean", "null"], "maxLength": 4096 },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000 }
      },
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "required": ["assertionId", "observation", "comparator"],
      "properties": {
        "assertionId": { "$ref": "common.schema.json#/$defs/id" },
        "observation": { "type": "string", "minLength": 1, "maxLength": 512 },
        "comparator": { "enum": ["V4_V5_EQUAL", "V4_V5_SHAPE_EQUAL", "EXPECTED_VALUE", "NO_ERROR"] },
        "expected": { "type": ["string", "number", "boolean", "null"] },
        "allowedDifference": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "sideEffect": { "const": "REVERSIBLE" } }, "required": ["sideEffect"] },
      "then": {
        "properties": {
          "executionPolicy": {
            "properties": { "authorizationRequired": { "const": true }, "cleanupRequired": { "const": true } }
          },
          "cleanup": { "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "sideEffect": { "const": "EXTERNAL_SIDE_EFFECT" } }, "required": ["sideEffect"] },
      "then": {
        "properties": {
          "executionPolicy": {
            "properties": { "mode": { "const": "USER_VISIBLE" }, "authorizationRequired": { "const": true } }
          }
        }
      }
    }
  ]
}
