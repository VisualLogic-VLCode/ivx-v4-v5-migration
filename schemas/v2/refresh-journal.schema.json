{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ivx.local/migration/v2/refresh-journal.schema.json",
  "title": "iVX Existing Target Refresh Journal v2",
  "type": "object",
  "required": ["schemaVersion", "kind", "refreshId", "planId", "planSha256", "authorizationId", "phase", "expectedTarget", "candidateSha256", "write", "attempts", "createdAt", "updatedAt", "createdBy", "sensitivity"],
  "properties": {
    "schemaVersion": { "const": 2 }, "kind": { "const": "refresh-journal" },
    "refreshId": { "type": "string", "pattern": "^rfr_[A-Za-z0-9_]+$" }, "planId": { "$ref": "common.schema.json#/$defs/id" },
    "planSha256": { "$ref": "common.schema.json#/$defs/sha256" }, "authorizationId": { "$ref": "common.schema.json#/$defs/id" },
    "phase": { "enum": ["NOT_STARTED", "WRITE_REQUESTED", "WRITE_OUTCOME_UNKNOWN", "READBACK_VERIFIED", "RECONCILIATION_REQUIRED", "TARGET_DRIFTED", "BASELINE_STILL_PRESENT"] },
    "expectedTarget": {
      "type": "object",
      "required": ["nid", "workId", "sha256", "configSha256", "settingsSha256", "routingSha256"],
      "properties": {
        "nid": { "type": "integer", "minimum": 1 },
        "workId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "configSha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "settingsSha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "routingSha256": { "$ref": "common.schema.json#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "candidateSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "write": {
      "type": "object",
      "required": ["requestedAt", "responseWorkId", "observedWorkId", "observedSha256", "errorCode"],
      "properties": {
        "requestedAt": { "oneOf": [{ "$ref": "common.schema.json#/$defs/dateTime" }, { "type": "null" }] },
        "responseWorkId": { "type": ["string", "null"], "maxLength": 256 },
        "observedWorkId": { "type": ["string", "null"], "maxLength": 256 },
        "observedSha256": { "oneOf": [{ "$ref": "common.schema.json#/$defs/sha256" }, { "type": "null" }] },
        "errorCode": { "type": ["string", "null"], "maxLength": 256 }
      },
      "additionalProperties": false
    },
    "attempts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["operation", "status", "at", "errorCode"],
        "properties": {
          "operation": { "$ref": "common.schema.json#/$defs/id" },
          "status": { "$ref": "common.schema.json#/$defs/id" },
          "at": { "$ref": "common.schema.json#/$defs/dateTime" },
          "errorCode": { "type": ["string", "null"], "maxLength": 256 }
        },
        "additionalProperties": false
      }
    },
    "createdAt": { "$ref": "common.schema.json#/$defs/dateTime" }, "updatedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "createdBy": { "const": "CLI" }, "sensitivity": { "const": "PRIVATE" }
  },
  "additionalProperties": false
}
