{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ivx.local/migration/v2/repair-proposal.schema.json",
  "title": "iVX Repair Proposal v2",
  "type": "object",
  "required": ["schemaVersion", "kind", "proposalId", "reviewId", "authorizationId", "clusterIds", "baseTarget", "patch", "affectedScenarioIds", "evidenceRefs", "knowledgeRuleIds", "confidence", "rationale", "createdAt", "createdBy", "sensitivity"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "repair-proposal" },
    "proposalId": { "$ref": "common.schema.json#/$defs/id" },
    "reviewId": { "$ref": "common.schema.json#/$defs/reviewId" },
    "authorizationId": { "$ref": "common.schema.json#/$defs/id" },
    "clusterIds": { "$ref": "common.schema.json#/$defs/stringArray", "minItems": 1, "maxItems": 50 },
    "baseTarget": {
      "type": "object",
      "required": ["nid", "workId", "sha256"],
      "properties": { "nid": { "type": "integer", "minimum": 1 }, "workId": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "common.schema.json#/$defs/sha256" } },
      "additionalProperties": false
    },
    "patch": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "required": ["op", "path"],
        "properties": { "op": { "enum": ["add", "remove", "replace"] }, "path": { "type": "string", "pattern": "^/", "maxLength": 2048 }, "value": true },
        "additionalProperties": false
      }
    },
    "affectedScenarioIds": { "$ref": "common.schema.json#/$defs/stringArray", "minItems": 1, "maxItems": 100 },
    "evidenceRefs": { "$ref": "common.schema.json#/$defs/stringArray" },
    "knowledgeRuleIds": { "$ref": "common.schema.json#/$defs/stringArray" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "createdAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "createdBy": { "const": "AGENT" },
    "sensitivity": { "const": "REDACTED" }
  },
  "additionalProperties": false
}
