{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ivx.local/migration/v2/automatic-repair-decision.schema.json",
  "title": "iVX Automatic Repair Decision v2",
  "type": "object",
  "required": ["schemaVersion", "kind", "decisionId", "reviewId", "clusterId", "cause", "repairTarget", "decision", "reasonCode", "reason", "budgetId", "budgetState", "remainingAttempts", "evidenceRefs", "knowledgeRuleIds", "decidedAt", "createdAt", "createdBy", "sensitivity"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "automatic-repair-decision" },
    "decisionId": { "$ref": "common.schema.json#/$defs/id" },
    "reviewId": { "$ref": "common.schema.json#/$defs/reviewId" },
    "clusterId": { "$ref": "common.schema.json#/$defs/id" },
    "cause": { "enum": ["CONVERTER", "SOURCE_DATA", "TARGET_CASE", "TEST_HARNESS", "ENVIRONMENT_CONFIGURATION", "PLATFORM_RUNTIME", "KNOWLEDGE_GAP", "AUTHORIZATION", "UNKNOWN"] },
    "repairTarget": { "enum": ["NONE", "V5_ARTIFACT", "RUNTIME_SCENARIO", "ENVIRONMENT_BINDING", "KNOWLEDGE_RULE", "AUTHORIZATION_PREREQUISITE"] },
    "decision": { "enum": ["AUTO_REPAIR_ALLOWED", "AUTO_REPAIR_PAUSED", "AUTO_REPAIR_STOPPED"] },
    "reasonCode": { "$ref": "common.schema.json#/$defs/id" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "budgetId": { "$ref": "common.schema.json#/$defs/id" },
    "budgetState": { "enum": ["AVAILABLE", "FROZEN", "EXHAUSTED"] },
    "remainingAttempts": { "type": "integer", "minimum": 0, "maximum": 100 },
    "evidenceRefs": { "$ref": "common.schema.json#/$defs/stringArray" },
    "knowledgeRuleIds": { "$ref": "common.schema.json#/$defs/stringArray" },
    "decidedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "createdAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "createdBy": { "$ref": "common.schema.json#/$defs/createdBy" },
    "sensitivity": { "$ref": "common.schema.json#/$defs/sensitivity" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "AUTO_REPAIR_ALLOWED" } }, "required": ["decision"] },
      "then": {
        "properties": {
          "cause": { "enum": ["SOURCE_DATA", "TARGET_CASE"] },
          "repairTarget": { "const": "V5_ARTIFACT" },
          "budgetState": { "const": "AVAILABLE" },
          "remainingAttempts": { "minimum": 1 }
        }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "AUTO_REPAIR_STOPPED" } }, "required": ["decision"] },
      "then": { "properties": { "budgetState": { "enum": ["FROZEN", "EXHAUSTED"] } } }
    },
    {
      "if": { "properties": { "budgetState": { "const": "EXHAUSTED" } }, "required": ["budgetState"] },
      "then": { "properties": { "remainingAttempts": { "const": 0 } } }
    }
  ]
}
