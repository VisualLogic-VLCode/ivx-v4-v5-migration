{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ivx.local/migration/v2/refresh-plan.schema.json",
  "title": "iVX Existing Target Refresh Plan v2",
  "type": "object",
  "required": ["schemaVersion", "kind", "planId", "refreshId", "source", "target", "runtime", "candidate", "identityRewrite", "configurationPolicy", "diagnostics", "expiresAt", "createdAt", "createdBy", "sensitivity"],
  "properties": {
    "schemaVersion": { "const": 2 }, "kind": { "const": "refresh-plan" },
    "planId": { "$ref": "common.schema.json#/$defs/id" }, "refreshId": { "type": "string", "pattern": "^rfr_[A-Za-z0-9_]+$" },
    "source": {
      "type": "object",
      "required": ["nid", "gid", "workId", "sha256", "classificationArtifact"],
      "properties": {
        "nid": { "type": "integer", "minimum": 1 },
        "gid": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "workId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "classificationArtifact": { "$ref": "common.schema.json#/$defs/safeRelativePath" }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["nid", "workId", "sha256", "configSha256", "settingsSha256", "routingSha256", "lineageJobId", "classificationArtifact"],
      "properties": {
        "nid": { "type": "integer", "minimum": 1 },
        "workId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "configSha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "settingsSha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "routingSha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "lineageJobId": { "$ref": "common.schema.json#/$defs/jobId" },
        "classificationArtifact": { "$ref": "common.schema.json#/$defs/safeRelativePath" }
      },
      "additionalProperties": false
    },
    "runtime": { "$ref": "#/$defs/runtime" },
    "candidate": {
      "type": "object",
      "required": ["artifact", "sha256", "validationArtifact", "structuralValidationPassed", "issueCount", "blockerCount"],
      "properties": {
        "artifact": { "$ref": "common.schema.json#/$defs/safeRelativePath" },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "validationArtifact": { "$ref": "common.schema.json#/$defs/safeRelativePath" },
        "structuralValidationPassed": { "const": true },
        "issueCount": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "blockerCount": { "type": "integer", "minimum": 0, "maximum": 100000 }
      },
      "additionalProperties": false
    },
    "identityRewrite": {
      "type": "object",
      "required": ["sourceNid", "targetNid"],
      "properties": { "sourceNid": { "type": "integer", "minimum": 1 }, "targetNid": { "type": "integer", "minimum": 1 } },
      "additionalProperties": false
    },
    "configurationPolicy": { "const": "PRESERVE_TARGET_CONFIGURATION" },
    "diagnostics": {
      "type": "object",
      "required": ["manifestArtifact", "converterDiagnosticsArtifact", "sha256", "total"],
      "properties": {
        "manifestArtifact": { "$ref": "common.schema.json#/$defs/safeRelativePath" },
        "converterDiagnosticsArtifact": { "oneOf": [{ "$ref": "common.schema.json#/$defs/safeRelativePath" }, { "type": "null" }] },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "total": { "type": "integer", "minimum": 0, "maximum": 100000 }
      },
      "additionalProperties": false
    },
    "expiresAt": { "$ref": "common.schema.json#/$defs/dateTime" }, "createdAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "createdBy": { "const": "CLI" }, "sensitivity": { "const": "PRIVATE" }
  },
  "$defs": {
    "runtime": {
      "type": "object",
      "required": ["workflow", "converter", "knowledge"],
      "properties": {
        "workflow": { "$ref": "common.schema.json#/$defs/runtimePin" },
        "converter": { "$ref": "common.schema.json#/$defs/runtimePin" },
        "knowledge": { "$ref": "#/$defs/knowledgePin" }
      },
      "additionalProperties": false
    },
    "knowledgePin": {
      "type": "object",
      "required": ["version", "sha256", "contentSha256", "schemaVersion", "ruleIds"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "contentSha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "ruleIds": { "$ref": "common.schema.json#/$defs/stringArray" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
