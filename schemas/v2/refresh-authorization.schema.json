{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ivx.local/migration/v2/refresh-authorization.schema.json",
  "title": "iVX Existing Target Refresh Authorization v2",
  "type": "object",
  "required": ["schemaVersion", "kind", "authorizationId", "refreshId", "planId", "planSha256", "source", "target", "candidateSha256", "diagnosticsSha256", "maxTargetRevisions", "confirmation", "expiresAt", "createdAt", "createdBy", "sensitivity"],
  "properties": {
    "schemaVersion": { "const": 2 }, "kind": { "const": "refresh-authorization" },
    "authorizationId": { "$ref": "common.schema.json#/$defs/id" }, "refreshId": { "type": "string", "pattern": "^rfr_[A-Za-z0-9_]+$" },
    "planId": { "$ref": "common.schema.json#/$defs/id" }, "planSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "source": {
      "type": "object",
      "required": ["workId", "sha256"],
      "properties": { "workId": { "type": "string", "minLength": 1, "maxLength": 256 }, "sha256": { "$ref": "common.schema.json#/$defs/sha256" } },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["nid", "workId", "sha256", "configSha256", "settingsSha256", "routingSha256"],
      "properties": {
        "nid": { "type": "integer", "minimum": 1 },
        "workId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "configSha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "settingsSha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "routingSha256": { "$ref": "common.schema.json#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "candidateSha256": { "$ref": "common.schema.json#/$defs/sha256" }, "diagnosticsSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "maxTargetRevisions": { "const": 1 }, "confirmation": { "const": "REFRESH_EXISTING_V5" },
    "expiresAt": { "$ref": "common.schema.json#/$defs/dateTime" }, "createdAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "createdBy": { "const": "USER" }, "sensitivity": { "const": "PRIVATE" }
  },
  "additionalProperties": false
}
