{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ivx.local/migration/v2/human-finding.schema.json",
  "title": "iVX Human Finding v2",
  "type": "object",
  "required": ["schemaVersion", "kind", "findingId", "reviewId", "issueId", "clusterId", "symptom", "reproductionSteps", "v4Observation", "v5Observation", "locations", "suggestedCause", "confidenceNote", "targetManuallyEdited", "targetRevision", "requests", "createdAt", "createdBy", "sensitivity"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "human-finding" },
    "findingId": { "$ref": "common.schema.json#/$defs/id" },
    "reviewId": { "$ref": "common.schema.json#/$defs/reviewId" },
    "issueId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }] },
    "clusterId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }] },
    "symptom": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "reproductionSteps": { "$ref": "common.schema.json#/$defs/stringArray" },
    "v4Observation": { "type": ["string", "null"], "maxLength": 8192 },
    "v5Observation": { "type": ["string", "null"], "maxLength": 8192 },
    "locations": { "$ref": "common.schema.json#/$defs/stringArray" },
    "suggestedCause": {
      "oneOf": [
        { "enum": ["CONVERTER", "SOURCE_DATA", "TARGET_CASE", "TEST_HARNESS", "ENVIRONMENT_CONFIGURATION", "PLATFORM_RUNTIME", "KNOWLEDGE_GAP", "AUTHORIZATION", "UNKNOWN"] },
        { "type": "null" }
      ]
    },
    "confidenceNote": { "type": ["string", "null"], "maxLength": 4096 },
    "targetManuallyEdited": { "type": "boolean" },
    "targetRevision": { "type": ["string", "null"], "maxLength": 256 },
    "requests": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "enum": ["RERUN", "RECLASSIFY", "CONVERTER_REPORT", "TRY_REPAIR", "ACCEPT_TARGET_REVISION"] }
    },
    "createdAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "createdBy": { "const": "USER" },
    "sensitivity": { "const": "PRIVATE" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "targetManuallyEdited": { "const": true } }, "required": ["targetManuallyEdited"] },
      "then": { "properties": { "targetRevision": { "type": "string", "minLength": 1 } } }
    }
  ]
}
