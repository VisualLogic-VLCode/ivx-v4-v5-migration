{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ivx.local/migration/v2/job-state.schema.json",
  "title": "iVX migration Job state v2 copy",
  "type": "object",
  "required": ["schemaVersion", "kind", "jobId", "status", "mode", "input", "runtime", "source", "target", "issues", "createdAt", "updatedAt", "history", "provenance"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "migration-job" },
    "jobId": { "$ref": "common.schema.json#/$defs/jobId" },
    "status": { "type": "string", "minLength": 1, "maxLength": 128 },
    "mode": { "enum": ["platform", "local-file"] },
    "input": {
      "type": "object",
      "required": ["sourceNid", "gid"],
      "properties": {
        "sourceNid": { "type": "integer", "minimum": 1 },
        "gid": { "type": ["integer", "null"], "minimum": 1 },
        "intent": { "enum": ["CREATE_V5", "CREATE_ADDITIONAL_V5"] },
        "relatedPriorJobIds": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/jobId" }
        }
      },
      "additionalProperties": false
    },
    "runtime": { "type": "object" },
    "source": { "type": "object" },
    "target": { "type": "object" },
    "issues": { "type": "object" },
    "createdAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "history": { "type": "array" },
    "provenance": {
      "type": "object",
      "required": ["sourceSchemaVersion", "sourceStateSha256", "migratedAt", "migrationMode"],
      "properties": {
        "sourceSchemaVersion": { "const": 1 },
        "sourceStateSha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "migratedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
        "migrationMode": { "const": "COPY" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
