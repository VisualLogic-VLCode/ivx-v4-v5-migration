{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ivx.local/migration/v2/agent-test-attestation.schema.json",
  "title": "iVX Agent Test Attestation v2",
  "type": "object",
  "required": ["schemaVersion", "kind", "attestationId", "sessionId", "authorizationId", "reviewId", "jobId", "sourceRevision", "targetRevision", "environment", "capability", "executor", "outcome", "coverage", "effects", "findings", "evidenceRefs", "claims", "completedAt", "createdAt", "createdBy", "sensitivity"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "agent-test-attestation" },
    "attestationId": { "$ref": "common.schema.json#/$defs/id" },
    "sessionId": { "$ref": "common.schema.json#/$defs/id" },
    "authorizationId": { "$ref": "common.schema.json#/$defs/id" },
    "reviewId": { "$ref": "common.schema.json#/$defs/reviewId" },
    "jobId": { "$ref": "common.schema.json#/$defs/jobId" },
    "sourceRevision": { "$ref": "#/$defs/subject" },
    "targetRevision": { "$ref": "#/$defs/subject" },
    "environment": {
      "type": "object",
      "required": ["comparisonId", "status", "mode"],
      "properties": {
        "comparisonId": { "$ref": "common.schema.json#/$defs/id" },
        "status": { "enum": ["ENVIRONMENT_EQUIVALENT", "NORMALIZED_EQUIVALENT", "REQUIRES_USER_BINDING", "BLOCKED_ENVIRONMENT"] },
        "mode": { "enum": ["EQUIVALENT_ONLY", "ALLOW_DIAGNOSTIC"] }
      },
      "additionalProperties": false
    },
    "capability": { "enum": ["AGENT_DIRECT_READ_ONLY", "AGENT_DIRECT_SIDE_EFFECT"] },
    "executor": {
      "type": "object",
      "required": ["kind", "product", "tools"],
      "properties": {
        "kind": { "const": "LOCAL_AI_AGENT" },
        "product": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tools": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
      },
      "additionalProperties": false
    },
    "outcome": { "enum": ["AGENT_ATTESTED_PARITY_OBSERVED", "AGENT_ATTESTED_MISMATCH", "AGENT_ATTESTED_INCONCLUSIVE"] },
    "coverage": {
      "type": "object",
      "required": ["businessFlows", "states", "actions", "assertions", "screenshots", "networkObservations"],
      "properties": {
        "businessFlows": { "type": "integer", "minimum": 0 }, "states": { "type": "integer", "minimum": 0 },
        "actions": { "type": "integer", "minimum": 0 }, "assertions": { "type": "integer", "minimum": 0 },
        "screenshots": { "type": "integer", "minimum": 0 }, "networkObservations": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "effects": {
      "type": "object",
      "required": ["attempted", "operationCount", "systems", "objectTypes", "actionClasses"],
      "properties": {
        "attempted": { "type": "boolean" }, "operationCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "systems": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string" } },
        "objectTypes": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string" } },
        "actionClasses": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array", "maxItems": 500,
      "items": {
        "type": "object", "required": ["findingId", "severity", "summary", "cause", "evidenceRefs"],
        "properties": {
          "findingId": { "$ref": "common.schema.json#/$defs/id" }, "severity": { "enum": ["INFO", "WARNING", "ERROR"] },
          "summary": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "cause": { "enum": ["CONVERTER", "SOURCE_DATA", "TARGET_CASE", "TEST_HARNESS", "ENVIRONMENT_CONFIGURATION", "PLATFORM_RUNTIME", "KNOWLEDGE_GAP", "AUTHORIZATION", "UNKNOWN"] },
          "evidenceRefs": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } }
        }, "additionalProperties": false
      }
    },
    "evidenceRefs": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
    "claims": {
      "type": "object", "required": ["parityObserved", "strictParityClaimed", "workflowDriverUsed", "targetModifiedByTest"],
      "properties": { "parityObserved": { "type": "boolean" }, "strictParityClaimed": { "const": false }, "workflowDriverUsed": { "const": false }, "targetModifiedByTest": { "type": "boolean" } },
      "additionalProperties": false
    },
    "completedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "createdAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "createdBy": { "const": "AGENT" },
    "sensitivity": { "const": "REDACTED" }
  },
  "$defs": {
    "subject": { "type": "object", "required": ["nid", "workId"], "properties": { "nid": { "type": "integer", "minimum": 1 }, "workId": { "type": "string", "minLength": 1, "maxLength": 256 } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
