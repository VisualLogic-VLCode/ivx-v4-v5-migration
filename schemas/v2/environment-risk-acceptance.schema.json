{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ivx.local/migration/v2/environment-risk-acceptance.schema.json",
  "title": "iVX diagnostic runtime environment-risk acceptance v2",
  "type": "object",
  "required": ["schemaVersion", "kind", "acceptanceId", "reviewId", "sourceRevision", "targetRevision", "acceptedPaths", "scenarioIds", "purpose", "confirmation", "expiresAt", "createdAt", "createdBy", "sensitivity"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "environment-risk-acceptance" },
    "acceptanceId": { "$ref": "common.schema.json#/$defs/id" },
    "reviewId": { "$ref": "common.schema.json#/$defs/reviewId" },
    "sourceRevision": { "$ref": "environment-comparison.schema.json#/$defs/revision" },
    "targetRevision": { "$ref": "environment-comparison.schema.json#/$defs/revision" },
    "acceptedPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^/", "maxLength": 512 }
    },
    "scenarioIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/id" }
    },
    "purpose": { "const": "DIAGNOSTIC_RUNTIME_ONLY" },
    "confirmation": { "const": "ACCEPT_ENVIRONMENT_RISK" },
    "expiresAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "createdAt": { "$ref": "common.schema.json#/$defs/dateTime" },
    "createdBy": { "const": "USER" },
    "sensitivity": { "const": "PRIVATE" }
  },
  "additionalProperties": false
}
