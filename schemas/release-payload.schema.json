{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "iVX migration runtime release payload",
  "type": "object",
  "required": ["schemaVersion", "kind", "channel", "latest", "versions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "enum": ["workflow", "converter", "knowledge"] },
    "channel": { "enum": ["stable", "canary"] },
    "latest": { "type": "string" },
    "minimumSupported": { "type": ["string", "null"] },
    "revoked": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "versions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["packageName", "artifact"],
        "properties": {
          "packageName": { "type": "string" },
          "compatibleWorkflow": { "type": ["string", "null"] },
          "compatibleConverter": { "type": ["string", "null"] },
          "compatibleAgentProtocol": {
            "type": ["object", "null"],
            "required": ["min", "max"],
            "properties": {
              "min": { "type": "integer", "minimum": 1 },
              "max": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          },
          "knowledgeSchemaVersion": { "type": ["integer", "null"] },
          "contentSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "agentProtocolVersion": { "type": ["integer", "null"] },
          "jobSchemaVersion": { "type": ["integer", "null"] },
          "capabilities": { "type": "object" },
          "artifact": {
            "type": "object",
            "required": ["url", "sha256"],
            "properties": {
              "url": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
