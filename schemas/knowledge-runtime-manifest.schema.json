{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "iVX V4-to-V5 Knowledge Runtime manifest",
  "type": "object",
  "required": ["schemaVersion", "kind", "version", "knowledgeSchemaVersion", "contentSha256", "compatibility", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "ivx-v4-v5-knowledge-runtime" },
    "version": { "type": "string" },
    "knowledgeSchemaVersion": { "const": 1 },
    "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "compatibility": {
      "type": "object",
      "required": ["workflow", "converter", "agentProtocol"],
      "properties": {
        "workflow": { "type": "string" },
        "converter": { "type": "string" },
        "agentProtocol": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
